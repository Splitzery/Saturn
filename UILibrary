-- designRect: { Y = <top offset>, H = <height> } for the accent bar.
-- rightInset: room the element's control needs on the right.
-- noGrow: skip two-line height growth (for elements with managed heights).
local function BaseElement(page, name, description, height, designRect, rightInset, noGrow)
	height = height or ELEMENT_H
	rightInset = rightInset or 70

	local frame = Create("Frame", {
		Name = name .. "Frame",
		Size = UDim2.new(1, -8, 0, height),
		BackgroundColor3 = Theme.Element,
		BorderSizePixel = 0,
		Active = true,
		Parent = page,
	})
	Corner(10, frame)

	local dh = designRect and designRect.H or (height - 30)
	local dy = designRect and designRect.Y or math.floor((height - dh) / 2)

	local design = Create("Frame", {
		Name = "Design",
		Size = UDim2.new(0, 4, 0, dh),
		Position = UDim2.new(0, 7, 0, dy),
		AnchorPoint = Vector2.new(0, 0),
		BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0,
		Parent = frame,
	})
	Corner(8, design)
	AccentGradient(design)
	Shadow(design, Theme.Accent, 0.21, 10)

	local title = Create("TextLabel", {
		Name = "Title",
		Size = UDim2.new(1, -(29 + rightInset), 0, 18),
		Position = UDim2.new(0, 29, 0, 14),
		BackgroundTransparency = 1,
		Text = name,
		TextColor3 = Theme.TextBright,
		TextSize = 14,
		TextScaled = false,
		TextWrapped = false,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextXAlignment = Enum.TextXAlignment.Left,
		FontFace = FONT_MED,
		Parent = frame,
	})

	local desc = Create("TextLabel", {
		Name = "Description",
		Size = UDim2.new(1, -(29 + rightInset), 0, 28),   -- room for two lines
		Position = UDim2.new(0, 29, 0, 35),
		BackgroundTransparency = 1,
		Text = description or "",
		TextColor3 = Theme.TextMuted,
		TextSize = 12,
		TextScaled = false,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		FontFace = FONT_MED,
		Parent = frame,
	})

	-- Blocks input and dims the card when the element is disabled.
	local veil = Create("TextButton", {
		Name = "Veil",
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundColor3 = Theme.Element,
		BackgroundTransparency = 0.45,
		Text = "",
		AutoButtonColor = false,
		Active = true,
		Visible = false,
		ZIndex = 50,
		Parent = frame,
	})
	Corner(10, veil)

	-- Stars in the strip above the title. Every element puts its title at
	-- y=14 and centres its control on the card, so y 1-13 across the full
	-- width is blank on all of them -- unlike a band measured off the text,
	-- which collapsed to nothing whenever a description or inset ran wide.
	local dust = Create("Frame", {
		Name = "Dust",
		Size = UDim2.new(1, -41, 0, 12),
		Position = UDim2.new(0, 29, 0, 1),
		BackgroundTransparency = 1,
		ZIndex = 0,
		Parent = frame,
	})

	do
		local rng = Random.new()
		for i = 1, 3 do
			Twinkle(dust, (i - 0.5) / 3 + rng:NextNumber(-0.14, 0.14),
				rng:NextNumber(0.2, 0.8), rng, 0.92, 0.965, 0.06, 0.13)
		end
	end

	frame:SetAttribute("BaseHeight", height)

	-- Only standard-height elements grow; sliders and pickers manage their own.
	if not noGrow and height == ELEMENT_H then
		local function fitHeight()
			local h = (desc.TextBounds.Y > 16) and ELEMENT_H2 or ELEMENT_H
			if frame.Size.Y.Offset ~= h then
				frame.Size  = UDim2.new(1, -8, 0, h)
				design.Size = UDim2.new(0, 4, 0, h - 30)
			end
			frame:SetAttribute("BaseHeight", h)
		end
		desc:GetPropertyChangedSignal("TextBounds"):Connect(fitHeight)
		desc:GetPropertyChangedSignal("AbsoluteSize"):Connect(fitHeight)
		fitHeight()
	end

	return frame, design
end

