local CoreGui = nil
local okCoreGui, coreGuiObj = pcall(function()
	return game:GetService("CoreGui")
end)
if okCoreGui and coreGuiObj then
	CoreGui = coreGuiObj
end
local SaturnRootGui = nil

local function HasGuiFunction(func)
	return type(func) == "function"
end

local function IsSafeGui(obj)
	return typeof(obj) == "Instance" and obj:IsA("ScreenGui") and obj.Parent ~= nil
end

local function SafeGuiFromEnv(name)
	local func = Env[name]
	if not HasGuiFunction(func) then
		return nil
	end

	local ok, result = pcall(function()
		return func()
	end)
	if ok and IsSafeGui(result) then
		return result
	end

	return nil
end

local function DestroyStaleSaturnUI()
	if not CoreGui then
		return
	end
	local stale = CoreGui:FindFirstChild("SaturnUI")
	if stale and stale:IsA("ScreenGui") then
		stale:Destroy()
	end
end

local function CreateSaturnParentGui()
	if not CoreGui then
		return nil
	end
	local existing = CoreGui:FindFirstChild("SaturnUI")
	if existing and existing:IsA("ScreenGui") then
		return existing
	end

	local gui = Instance.new("ScreenGui")
	gui.Name = "SaturnUI"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.DisplayOrder = 1000
	gui.Parent = CoreGui
	return gui
end

local function GetSafeGuiParent()
	if IsStudio and LocalPlayer then
		local ok, playerGui = pcall(function()
			return LocalPlayer:FindFirstChild("PlayerGui") or LocalPlayer.PlayerGui
		end)
		if ok and playerGui and playerGui:IsA("PlayerGui") then
			return playerGui
		end
	end

	if not SaturnRootGui then
		SaturnRootGui = CreateSaturnParentGui()
	end
	return SaturnRootGui
end

local function InstallSafeGuiShims(gui)
	if IsStudio then
		return
	end

	local safeGetGui = function()
		return gui
	end

	local existingGui = SafeGuiFromEnv("getgui") or SafeGuiFromEnv("gethui")
	if not existingGui then
		Env.getgui = safeGetGui
	end

	if not HasGuiFunction(Env.gethui) then
		Env.gethui = Env.getgui
	elseif not IsSafeGui(SafeGuiFromEnv("gethui")) then
		Env.gethui = Env.getgui
	end
end

DestroyStaleSaturnUI()
if not IsStudio then
	SaturnRootGui = CreateSaturnParentGui()
	InstallSafeGuiShims(SaturnRootGui)
else
	SaturnRootGui = LocalPlayer and LocalPlayer:FindFirstChild("PlayerGui") or nil
end

