					Transparency = NumberSequence.new({
						NumberSequenceKeypoint.new(0, 1),   -- tail
						NumberSequenceKeypoint.new(1, 0),   -- head
					}),
					Parent = streak,
				})

				Tween(streak, TweenInfo.new(1.0, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
					Position = UDim2.new(fx + 0.16, 0, fy + 0.38, 0),
					Size = UDim2.new(0, 32, 0, 2),
				})
				task.delay(0.5, function()
					if streak.Parent then
						Tween(streak, TweenInfo.new(0.5), {
							BackgroundTransparency = 1,
							Size = UDim2.new(0, 0, 0, 2),
						})
					end
				end)
				task.delay(1.1, function() streak:Destroy() end)
			end
		end)
	end


