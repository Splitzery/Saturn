function Tab:Destroy()
	local w = self.Window

	for i, t in ipairs(w.Tabs) do
		if t == self then
			table.remove(w.Tabs, i)
			break
		end
	end

	-- Sidebar positions are index-driven, so the survivors have to renumber.
	local n = 0
	for _, t in ipairs(w.Tabs) do
		if not t.Pinned then
			n += 1
			t.SidebarIndex = n
			t.Button.LayoutOrder = n
		end
	end
	w.SidebarCount = n

	if w.ActiveTab == self then
		w.ActiveTab = nil
		for _, t in ipairs(w.Tabs) do
			if not t.Pinned then
				w:_selectTab(t)
				break
			end
		end
	end

	self.Button:Destroy()
	self.Page:Destroy()
end

