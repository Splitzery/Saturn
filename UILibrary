local Tab = {}
Tab.__index = Tab

-- A connection list scoped to one element, also registered with the window
-- so Window:Destroy still sweeps everything.
function Tab:_conns()
	local c = {}
	table.insert(self.Window.ConnGroups, c)
	return c
end

function Tab:_register(flag, getter, setter)
	if not flag then return end
	self.Window.Flags[flag] = getter      -- authoritative, per window
	Saturn.Flags[flag] = getter           -- convenience mirror
	if setter then
		self.Window.Setters[flag] = setter  -- silent, used by LoadConfig
	end
end

-- Queues the element's callback so Window:ApplyDefaults() can push its current
-- value into the game. FireOnInit runs it immediately instead of waiting.
function Tab:_onInit(getValue, opts)
	local fn = function()
		if opts.Callback then task.spawn(opts.Callback, getValue()) end
	end
	table.insert(self.Window.InitCallbacks, fn)
	if opts.FireOnInit then fn() end
end

function Tab:AddToggle(opts)
	opts = opts or {}
	local state = opts.Default or false

	-- A bind chip needs 54px more clearance than the switch alone.
	local bindable = opts.Bind ~= nil or opts.Bindable == true

	local frame = BaseElement(self.Page, opts.Name or "Toggle", opts.Description,
		nil, nil, bindable and 101 or 70)
	local conns = self:_conns()

	local bg = Create("Frame", {
		Name = "ToggleSwitchBG",
		Size = UDim2.new(0, 46, 0, 24),
		Position = UDim2.new(1, -58, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundColor3 = state and Theme.Accent or Theme.Panel,
		BorderSizePixel = 0,
		Parent = frame,
	})
	Corner(12, bg)
	AccentGradient(bg)
	Stroke(bg, Theme.Stroke, 1.1)

	local knob = Create("Frame", {
		Name = "ToggleSwitch",
		Size = UDim2.new(0, 20, 0, 20),
		Position = state and UDim2.new(1, -22, 0.5, 0) or UDim2.new(0, 2, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BorderSizePixel = 0,
		Parent = bg,
	})
	Corner(10, knob)

	local api = { Instance = frame }

	function api:Set(value, silent)
		state = value and true or false
		Tween(bg, FAST, { BackgroundColor3 = state and Theme.Accent or Theme.Panel })
		Tween(knob, FAST, { Position = state and UDim2.new(1, -22, 0.5, 0) or UDim2.new(0, 2, 0.5, 0) })
		if not silent and opts.Callback then task.spawn(opts.Callback, state) end
	end

	function api:Get() return state end

	ClickLayer(frame).MouseButton1Click:Connect(function()
		api:Set(not state)
	end)

	-- Bind chip, left of the switch with an 8px gap.
	local binding
	if bindable then
		local chip = Create("TextLabel", {
			Name = "BindChip",
			Size = UDim2.new(0, 23, 0, 24),      -- half the switch's width, same height
			Position = UDim2.new(1, -89, 0.5, 0),
			AnchorPoint = Vector2.new(0, 0.5),
			BackgroundColor3 = Theme.Panel,
			BorderSizePixel = 0,
			ClipsDescendants = true,
			Text = "None",
			TextColor3 = Theme.TextFaint,
			TextSize = 11,
			TextTruncate = Enum.TextTruncate.AtEnd,
			FontFace = FONT_MED,
			ZIndex = 10,          -- above the card's own click layer
			Parent = frame,
		})
		Corner(12, chip)
		local cs = Stroke(chip, Theme.Stroke, 1.1)

		binding = AttachBinding(ClickLayer(chip, 12), chip, cs, conns, opts.Bind,
			function() api:Set(not state) end,
			opts.OnBind)

		function api:GetBind() return binding.Get() end
		function api:SetBind(k) binding.Set(k) end

		if opts.BindFlag then
			self:_register(opts.BindFlag,
				function() return binding.Get() end,
				function(k) binding.Set(k) end)
		end
	end

	function api:SetDisabled(state2) ApplyDisabled(frame, state2) end
	function api:Destroy() DisconnectAll(conns) frame:Destroy() end

	self:_register(opts.Flag, function() return state end,
		function(v) api:Set(v, true) end)
	self:_onInit(function() return state end, opts)
	return api
end

