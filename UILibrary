end

-- UIShadow is only usable if we can give it a radius; a zero-radius shadow
-- renders as a hard rectangle sitting directly behind the object.
local USE_UISHADOW = true

local HAS_SHADOW = USE_UISHADOW and pcall(function() Instance.new("UIShadow"):Destroy() end)
local ShadowCaps = {}

if HAS_SHADOW then
	local probe = Instance.new("UIShadow")
	for _, p in ipairs({ "Radius", "Spread", "Blur", "Softness", "Size", "Distance", "Strength" }) do
		if pcall(function() return probe[p] end) then ShadowCaps[p] = true end
	end
	probe:Destroy()
	if next(ShadowCaps) == nil then
		HAS_SHADOW = false
	end
end

-- Image fallback for when UIShadow is unusable. OFF by default: a stretched
-- 9-slice of the wrong asset renders as a hard dark rectangle, which looks
-- worse than no shadow at all. Point SHADOW_IMAGE at a real soft-shadow
-- asset you have verified, then flip this on.
local SHADOW_FALLBACK = false
local SHADOW_IMAGE = "rbxassetid://1316045217"
local SHADOW_SLICE = Rect.new(10, 10, 118, 118)

local function Shadow(target, color, transparency, spread)
	spread = spread or 16

	-- A CanvasGroup renders descendants into a buffer its own size, which
	-- would clip a UIShadow child. Use the sibling image for those.
	if HAS_SHADOW and not target:IsA("CanvasGroup") then
		local s = Instance.new("UIShadow")
		pcall(function()
			if color then s.Color = color end
			s.Transparency = transparency or 0.4
		end)
		for prop in pairs(ShadowCaps) do
			pcall(function() s[prop] = spread end)
		end
		s.Parent = target
		return s
	end

	if not SHADOW_FALLBACK then return nil end

	local holder = target.Parent
	if not holder then return nil end

	local img = Create("ImageLabel", {
		Name = "ShadowFallback",
		BackgroundTransparency = 1,
		Image = SHADOW_IMAGE,
		ImageColor3 = color or Color3.new(0, 0, 0),
		ImageTransparency = transparency or 0.4,
		ScaleType = Enum.ScaleType.Slice,
		SliceCenter = SHADOW_SLICE,
		ZIndex = math.max(target.ZIndex - 1, 0),
		Parent = holder,
	})

	local function sync()
		img.Size = UDim2.new(0, target.AbsoluteSize.X + spread * 2,
		                     0, target.AbsoluteSize.Y + spread * 2)
		img.Position = UDim2.new(
			0, target.AbsolutePosition.X - holder.AbsolutePosition.X - spread,
			0, target.AbsolutePosition.Y - holder.AbsolutePosition.Y - spread)
		img.Visible = target.Visible
	end

	target:GetPropertyChangedSignal("AbsoluteSize"):Connect(sync)
	target:GetPropertyChangedSignal("AbsolutePosition"):Connect(sync)
	target:GetPropertyChangedSignal("Visible"):Connect(sync)
	holder:GetPropertyChangedSignal("AbsolutePosition"):Connect(sync)
	sync()
	return img
end

local function Tween(inst, info, goal)
	local t = TweenService:Create(inst, info, goal)
	t:Play()
	return t
end

local function round(n, decimals)
	local m = 10 ^ (decimals or 0)
	return math.floor(n * m + 0.5) / m
end

-- heightOverride: treat the host as at least this tall, for elements that are
-- about to expand underneath the ripple.
local STAR_TINTS = {
	Color3.fromRGB(168, 190, 240),
	Color3.fromRGB(198, 212, 252),
	Color3.fromRGB(146, 166, 218),
}

-- One star: circular, faint, and twinkling on a looping reversing tween so
-- the engine owns the animation and no Lua runs per frame.
local function Twinkle(parent, x, y, rng, dimLo, dimHi, swingLo, swingHi)
	local px  = rng:NextInteger(2, 3)
	local dim = rng:NextNumber(dimLo, dimHi)

	local star = Create("Frame", {
		Name = "Star",
		Size = UDim2.new(0, px, 0, px),
		Position = UDim2.new(x, 0, y, 0),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = STAR_TINTS[rng:NextInteger(1, #STAR_TINTS)],
		BackgroundTransparency = dim,
		BorderSizePixel = 0,
		Parent = parent,
	})
	Round(star)

	Tween(star, TweenInfo.new(
		rng:NextNumber(1.8, 3.6), Enum.EasingStyle.Sine,
		Enum.EasingDirection.InOut, -1, true, rng:NextNumber(0, 2)),
		{ BackgroundTransparency = dim - rng:NextNumber(swingLo, swingHi) })

	return star
end

local function Ripple(host, input, heightOverride)
	local w = host.AbsoluteSize.X
	local h = math.max(host.AbsoluteSize.Y, heightOverride or 0)
	if w < 1 or h < 1 then return end

	local px = input.Position.X - host.AbsolutePosition.X
	local py = input.Position.Y - host.AbsolutePosition.Y

	local far = math.max(
		math.sqrt(px ^ 2 + py ^ 2),
		math.sqrt((w - px) ^ 2 + py ^ 2),
		math.sqrt(px ^ 2 + (h - py) ^ 2),
		math.sqrt((w - px) ^ 2 + (h - py) ^ 2))
	local d = far * 2

	local circle = Create("Frame", {
		Name = "Ripple",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, px, 0, py),
		Size = UDim2.new(0, 0, 0, 0),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BackgroundTransparency = 0.93,
		BorderSizePixel = 0,
		Parent = host,
	})
	Create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = circle })

	Tween(circle, RIPPLE_SIZE, { Size = UDim2.new(0, d, 0, d) })
	local fade = Tween(circle, RIPPLE_FADE, { BackgroundTransparency = 1 })
	fade.Completed:Connect(function() circle:Destroy() end)
end

-- heightHint may be a number or a function returning one.
local function ClickLayer(parent, cornerRadius, heightHint)
	local host = Create("Frame", {
		Name = "RippleHost",
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		ZIndex = 0,
		Parent = parent,
	})
	Corner(cornerRadius or 10, host)

	local btn = Create("TextButton", {
		Name = "ClickLayer",
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		ZIndex = parent.ZIndex + 5,
		Parent = parent,
	})

	btn.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
			local hint = (type(heightHint) == "function") and heightHint() or heightHint
			Ripple(host, input, hint)
		end
	end)

	return btn, host
end

-- `track` captures the input; `measure` (default: track) defines the 0..1 range.
local function BindHorizontalDrag(track, cb, conns, measure)
	measure = measure or track
	local dragging = false

	local function update(input)
		local alpha = math.clamp(
			(input.Position.X - measure.AbsolutePosition.X) / math.max(measure.AbsoluteSize.X, 1), 0, 1)
		cb(alpha)
	end

	table.insert(conns, track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			update(input)
		end
	end))

	table.insert(conns, UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch) then
			update(input)
		end
	end))

	table.insert(conns, UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end))
end

-- Same contract, two axes. cb(x, y) with both clamped 0..1.
local function BindAreaDrag(track, cb, conns, measure)
	measure = measure or track
	local dragging = false

	local function update(input)
		local ax = math.clamp(
			(input.Position.X - measure.AbsolutePosition.X) / math.max(measure.AbsoluteSize.X, 1), 0, 1)
		local ay = math.clamp(
			(input.Position.Y - measure.AbsolutePosition.Y) / math.max(measure.AbsoluteSize.Y, 1), 0, 1)
		cb(ax, ay)
	end

	table.insert(conns, track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			update(input)
		end
	end))

	table.insert(conns, UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch) then
			update(input)
		end
	end))

	table.insert(conns, UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end))
end

-- Removing the CanvasGroups took GroupTransparency with them, so a teardown
-- has to fade the tree by hand. One pass, only ever run once, at destroy.
local function FadeOutTree(root, info)
	for _, d in ipairs(root:GetDescendants()) do
		if d:IsA("GuiObject") then
			Tween(d, info, { BackgroundTransparency = 1 })
			if d:IsA("TextLabel") or d:IsA("TextBox") or d:IsA("TextButton") then
				Tween(d, info, { TextTransparency = 1 })
			end
			if d:IsA("ImageLabel") or d:IsA("ImageButton") then
				Tween(d, info, { ImageTransparency = 1 })
			end
		elseif d:IsA("UIStroke") then
			Tween(d, info, { Transparency = 1 })
		end
	end
end

local function DisconnectAll(list)
	for _, c in ipairs(list) do
		pcall(function() c:Disconnect() end)
	end
	table.clear(list)
end

local function ApplyDisabled(frame, state)
	local on = state and true or false

	local v = frame:FindFirstChild("Veil")
	if v then v.Visible = on end

	frame:SetAttribute("Disabled", on)

	-- Dust would show through the veil; a disabled card should read as empty.
	local d = frame:FindFirstChild("Dust")
	if d then d.Visible = not on end
end

-- Config values have to survive JSONEncode, so wrap the types that can't.
local function EncodeValue(v)
	local t = typeof(v)
	if t == "Color3" then
		return { __type = "Color3",
			R = math.round(v.R * 255), G = math.round(v.G * 255), B = math.round(v.B * 255) }
	elseif t == "EnumItem" then
		return { __type = "EnumItem", Enum = tostring(v.EnumType), Name = v.Name }
	end
	return v
end

local function DecodeValue(v)
	if type(v) == "table" and v.__type == "Color3" then
		return Color3.fromRGB(v.R or 0, v.G or 0, v.B or 0)
	elseif type(v) == "table" and v.__type == "EnumItem" then
		local ok, item = pcall(function() return Enum.KeyCode[v.Name] end)
		return ok and item or nil
	end
	return v
end

-- Click `trigger` to rebind: Escape cancels, Backspace clears.
-- onPress fires when the bound key is pressed outside of capture.
local function AttachBinding(trigger, display, stroke, conns, default, onPress, onBind)
	local key = default
	local listening = false

	local function paint()
		display.Text = key and key.Name or "None"
		display.TextColor3 = key and Theme.TextBright or Theme.TextFaint
		Tween(stroke, FAST, { Color = Theme.Stroke })
	end

	trigger.MouseButton1Click:Connect(function()
		if listening then return end
		listening = true
		Saturn._capturing = true
		display.Text = "..."
		display.TextColor3 = Theme.Accent
		Tween(stroke, FAST, { Color = Theme.Accent })
	end)

	table.insert(conns, UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if listening then
			-- Backing out. Escape is the keyboard route, but a device with no
			-- keyboard would otherwise be stuck listening forever -- and stuck
			-- listening means Saturn._capturing blocks every bind globally.
			if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
				listening = false
				paint()
				task.defer(function() Saturn._capturing = false end)
				return
			end

			if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
			if input.KeyCode == Enum.KeyCode.Unknown then return end

			listening = false

			if input.KeyCode == Enum.KeyCode.Escape then
				-- cancel, keep the existing bind
			elseif input.KeyCode == Enum.KeyCode.Backspace then
				key = nil
			else
				key = input.KeyCode
			end

			paint()

			-- Cleared after this event finishes dispatching, so no other
			-- binding treats the capture press as an activation.
			task.defer(function() Saturn._capturing = false end)

			if onBind then task.spawn(onBind, key) end
			return
		end

		if gameProcessed or Saturn._capturing then return end
		if key and input.KeyCode == key and onPress then
			task.spawn(onPress, key)
		end
	end))

	paint()

	return {
		Get = function() return key end,
		Set = function(k) key = k paint() end,
	}
end


-- Touch has no hover, so anything hover-driven needs a position hit test.
-- InputObject.Position and AbsolutePosition share a space here, which is what
-- the slider and picker drags already rely on.
local function InBounds(obj, pos)
	local p, s = obj.AbsolutePosition, obj.AbsoluteSize
	return pos.X >= p.X and pos.X <= p.X + s.X
	and pos.Y >= p.Y and pos.Y <= p.Y + s.Y
end

local function markerPos(alpha, bar)
	local w = bar.AbsoluteSize.X
	if w < 8 then
		return UDim2.new(math.clamp(alpha, 0, 1), 0, 0.5, 0)
	end
	local inset = 3 / w
	return UDim2.new(math.clamp(alpha, inset, 1 - inset), 0, 0.5, 0)
end

