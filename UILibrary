		Expanded = false,
		Animating = false,
		Locked = false,
		ToggleKey = opts.ToggleKey or Enum.KeyCode.RightControl,
	}, Window)

	-- Keep the highlight glued to the list if the sidebar ever scrolls.
	table.insert(self_.Connections,
		sideBarContainer:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
			local t = self_.ActiveTab
			if t and not t.Pinned then
				selectionBox.Position = UDim2.new(0, 0, 0,
					(t.SidebarIndex - 1) * TAB_STEP - sideBarContainer.CanvasPosition.Y)
			end
		end))

	local dragHandle = Create("TextButton", {
		Name = "DragHandle",
		Size = UDim2.new(1, 0, 0, 46),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 0,
		Parent = body,
	})

	do
		local dragging, dragStart, startPos = false, nil, nil
		local target, stepConn

		-- Text rendered at a half-pixel offset is filtered rather than drawn
		-- crisply. The smoothed drag lands on fractional offsets, and a
		-- centred panel on an odd-width viewport is off by half a pixel
		-- before anyone touches it. Nudge the offset so the panel's absolute
		-- position sits on whole pixels; works whatever the anchor or scale.
		local function snapToPixels()
			local ap = root.AbsolutePosition
			local dx = math.round(ap.X) - ap.X
			local dy = math.round(ap.Y) - ap.Y
			if dx ~= 0 or dy ~= 0 then
				local p = root.Position
				root.Position = UDim2.new(
					p.X.Scale, p.X.Offset + dx,
					p.Y.Scale, p.Y.Offset + dy)
			end
		end
		self_.SnapToPixels = snapToPixels
		task.defer(snapToPixels)

		local function stopStepping()
			if stepConn then
				stepConn:Disconnect()
				stepConn = nil
			end
		end

		local function beginDrag(input)
			if self_.Locked or self_.Minimized or self_.Animating then return end
			if input.UserInputType ~= Enum.UserInputType.MouseButton1
			and input.UserInputType ~= Enum.UserInputType.Touch then return end

			dragging  = true
			dragStart = input.Position
			startPos  = root.Position
			target    = startPos

			-- Chase the pointer instead of snapping to it: input events arrive
			-- at poll rate, so writing Position straight through shows every
			-- jitter. Only runs while a drag is live.
			if not stepConn then
				stepConn = RunService.RenderStepped:Connect(function(dt)
					if not target then return end
					root.Position = root.Position:Lerp(target, 1 - math.exp(-DRAG_SMOOTH * dt))
				end)
			end
		end

		table.insert(self_.Connections, dragHandle.InputBegan:Connect(beginDrag))
		table.insert(self_.Connections, adjust.InputBegan:Connect(beginDrag))

		table.insert(self_.Connections, UserInputService.InputChanged:Connect(function(input)
			if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
				local delta = input.Position - dragStart
				target = UDim2.new(
					startPos.X.Scale, startPos.X.Offset + delta.X,
					startPos.Y.Scale, startPos.Y.Offset + delta.Y)
			end
		end))

		table.insert(self_.Connections, UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType ~= Enum.UserInputType.MouseButton1
			and input.UserInputType ~= Enum.UserInputType.Touch then return end
			dragging = false

			-- Freeze exactly where it is. Coasting on to the last pointer
			-- target would keep moving it after the button came up.
			target = root.Position
			stopStepping()
			snapToPixels()
			target = root.Position
		end))

		table.insert(self_.Connections, {
			Disconnect = stopStepping,   -- swept by Window:Destroy
		})
	end

	-- Arming steps the yellow light aside, widens red into its slot, and
	-- turns green into cancel. The notification's timer bar counts the
	-- window down; ignoring it puts everything back.
	do
		local armed, armGen = false, 0
		local armNotif

		local function destroyNow()
			-- Shrink and dissolve together. Fading the whole tree is what
			-- stops it reading as a pop: the scale alone just made things
			-- smaller and then removed them mid-frame.
			Tween(scale, DESTROY_OUT, { Scale = 0.9 })
			FadeOutTree(gui, DESTROY_OUT)
			task.delay(0.38, function() self_:Destroy() end)
		end

		-- A generation counter instead of task.cancel: the auto-disarm runs
		-- inside the very thread a cancel would kill, which is why the ring
		-- used to stick.
		local function disarm()
			if not armed then return end
			armed = false
			self_.CloseArmed = false
			armGen += 1

			-- Take the prompt with it; Dismiss is a no-op if it already went.
			if armNotif then
				armNotif.Dismiss()
				armNotif = nil
			end

			Tween(adjust, ARM_TINT, { BackgroundColor3 = Theme.Background })

			-- Already collapsed? The two-button layout is correct as-is.
			if self_.Minimized then return end

			Tween(adjust, SLIDE, { Size = UDim2.new(0, ADJUST_W_FULL, 0, ADJUST_H) })
			Tween(closeBtn,  SLIDE, { Position = UDim2.new(0, LIGHT_FULL.Close,  0.5, -6) })
			Tween(expandBtn, SLIDE, { Position = UDim2.new(0, LIGHT_FULL.Expand, 0.5, -6) })

			task.delay(0.12, function()
				if armed then return end
				minimizeBtn.Visible = true
				Tween(minimizeBtn, FADE, { BackgroundTransparency = 0 })
			end)
		end

		self_.DisarmClose = disarm

		closeBtn.MouseButton1Click:Connect(function()
			if opts.ConfirmClose == false then
				destroyNow()
				return
			end

			if armed then
				armed = false
				self_.CloseArmed = false
				armGen += 1
				if armNotif then
					armNotif.Dismiss()
					armNotif = nil
				end
				destroyNow()
				return
			end

			armed = true
			self_.CloseArmed = true
			armGen += 1
			local gen = armGen

			-- Yellow leaves and the pill closes up around the two that are
			-- left: the same geometry minimising uses. The dark fill is what
			-- tells the two states apart.
			Tween(minimizeBtn, FADE, { BackgroundTransparency = 1 })
			task.delay(0.14, function()
				if armGen ~= gen then return end
				minimizeBtn.Visible = false
				Tween(adjust, SLIDE, { Size = UDim2.new(0, ADJUST_W_MIN, 0, ADJUST_H) })
				Tween(closeBtn,  SLIDE, { Position = UDim2.new(0, LIGHT_MIN.Close,  0.5, -6) })
				Tween(expandBtn, SLIDE, { Position = UDim2.new(0, LIGHT_MIN.Expand, 0.5, -6) })
				-- Fill washes in as they move, so it reads as one gesture.
				Tween(adjust, ARM_TINT, { BackgroundColor3 = Theme.Danger })
			end)

			armNotif = self_:Notify({
				Title = "Close Saturn?",
				Text = "Red to confirm, green to cancel.",
				Type = "error",
				Duration = CONFIRM_WINDOW,
			})

			task.delay(CONFIRM_WINDOW, function()
				if armGen == gen then disarm() end
			end)
		end)
	end

	-- Hover intent: dwell in the zone before it slides out, so sweeping the
	-- cursor past on the way somewhere else does nothing. Leaving cancels a
	-- pending reveal outright; retracting waits, to cover the gap between
	-- the widgets.
	do
		local DWELL, LINGER = 0.25, 0.3
		local showTask, hideTask
		local hovering = false

		local function cancel(t)
			if t then task.cancel(t) end
			return nil
		end

		-- The actual slide-out, also exposed for programmatic use.
		local function reveal()
			if self_.Minimized then return end
			if self_.SearchOpen or self_.SearchPeek then return end
			self_.SearchPeek = true
			searchFrame.Visible = true
			Tween(searchFrame, SMOOTH, { Position = UDim2.new(0.5, 51, 0, -28) })
		end

		local function hideSearch()
			hovering = false
			showTask = cancel(showTask)
			hideTask = cancel(hideTask)
			hideTask = task.delay(LINGER, function()
				hideTask = nil
				if self_.SearchOpen then return end
				self_.SearchPeek = false
				Tween(searchFrame, SMOOTH, { Position = UDim2.new(0.5, 19, 0, -28) })
				task.delay(0.28, function()
					if not self_.SearchPeek and not self_.SearchOpen then
						searchFrame.Visible = false
					end
				end)
			end)
		end

		local function onEnter()
			hovering = true
			hideTask = cancel(hideTask)
			showTask = cancel(showTask)
			showTask = task.delay(DWELL, function()
				showTask = nil
				if hovering then reveal() end
			end)
		end

		self_.ShowSearch, self_.HideSearch = reveal, hideSearch
		self_.IsHoveringWidgets = function() return hovering end

		-- The pad already contains the peeked search, so it is the only
		-- trigger needed and the lights stay out of it entirely.
		table.insert(self_.Connections, hoverPad.MouseEnter:Connect(onEnter))
		table.insert(self_.Connections, hoverPad.MouseLeave:Connect(hideSearch))

		-- Touch has no hover: a tap in the zone peeks it out straight away
		-- (no dwell needed, a tap is already deliberate), and a tap anywhere
		-- else puts it back.
		table.insert(self_.Connections,
			UserInputService.InputBegan:Connect(function(input)
				if input.UserInputType ~= Enum.UserInputType.Touch then return end

				if InBounds(hoverPad, input.Position) then
					hovering = true
					reveal()
				elseif not self_.SearchOpen
					and not InBounds(searchFrame, input.Position) then
					hideSearch()
				end
			end))
	end

	searchBtn.MouseButton1Click:Connect(function()
		self_:ToggleSearch()
	end)

	table.insert(self_.Connections,
		searchBox:GetPropertyChangedSignal("Text"):Connect(function()
			self_:_applySearch(searchBox.Text)
		end))

	-- Leaving an empty field closes it; leaving a filled one keeps the filter.
	searchBox.FocusLost:Connect(function()
		if searchBox.Text == "" then
			self_:ToggleSearch(false)
		end
	end)

	minimizeBtn.MouseButton1Click:Connect(function()
		if self_.CloseArmed then self_.DisarmClose() return end
		self_:Minimize()
	end)

	expandBtn.MouseButton1Click:Connect(function()
		if self_.CloseArmed then self_.DisarmClose() return end
		if self_.Minimized then
			self_:Restore()
			return
		end
		if self_.Animating then return end
		self_.Expanded = not self_.Expanded
		self_.BaseSize = self_.Expanded and UDim2.new(0, 620, 0, 380) or baseSize
		Tween(root, SMOOTH, { Size = self_.BaseSize })
		task.delay(0.3, function()
			if self_.SnapToPixels then self_.SnapToPixels() end
		end)
	end)

	table.insert(self_.Connections, UserInputService.InputBegan:Connect(function(input, processed)
		if processed or Saturn._capturing then return end
		if input.KeyCode == self_.ToggleKey then
			self_:Toggle()
		end
	end))

	-- ------------------------------------------------------------
	--  Hardcoded Settings tab (pinned below the divider)
	-- ------------------------------------------------------------
	local settings = self_:CreateTab({
		Name = "Settings",
		Icon = opts.SettingsIcon or "rbxassetid://96527326588083",
		Pinned = true,
		Spin = true,
	})
	self_.SettingsTab = settings

	settings:AddSection("Interface")

	settings:AddKeybind({
		Name = "TOGGLE UI",
		Description = "Rebind the menu key.",
		Default = self_.ToggleKey,
		OnBind = function(k) self_.ToggleKey = k end,
	})

	settings:AddColorPicker({
		Name = "ACCENT COLOR",
		Description = "Recolors the interface.",
		Default = Theme.Accent,
		Callback = function(c) self_:SetAccent(c) end,
	})

	settings:AddSection("Config")

	-- Persistence backend is the game's choice. Pass SaveConfig/LoadConfig to
	-- CreateWindow to route these at a DataStore or a file; without them the
	-- buttons keep one snapshot in memory so they still do something.
	settings:AddButton({
		Name = "SAVE CONFIG",
		Description = "Stores the current control values.",
		Callback = function()
			local cfg = self_:GetConfig()
			if opts.SaveConfig then
				local ok, err = pcall(opts.SaveConfig, cfg)
				if ok then
					self_:Success("Saved", "Configuration stored.")
				else
					self_:Error("Save failed", tostring(err))
				end
			else
				self_._memoryConfig = cfg
				self_:Success("Saved", "Stored in memory for this session.")
			end
		end,
	})

	settings:AddButton({
		Name = "LOAD CONFIG",
		Description = "Restores the stored values.",
		Callback = function()
			local cfg
			if opts.LoadConfig then
				local ok, res = pcall(opts.LoadConfig)
				if ok then
					cfg = res
				else
					self_:Error("Load failed", tostring(res))
					return
				end
			else
				cfg = self_._memoryConfig
			end

			if not cfg then
				self_:Warn("Nothing stored", "Save a configuration first.")
				return
			end

			self_:LoadConfig(cfg)
			self_:Success("Loaded", "Configuration restored.")
		end,
	})

	settings:AddSection("Session")

	settings:AddButton({
		Name = "UNLOAD",
		Description = "Destroys the interface.",
		Callback = function() self_:Destroy() end,
	})

	-- ------------------------------------------------------------
	--  Intro
	-- ------------------------------------------------------------
	if opts.Intro ~= false then
		local dur = opts.IntroDuration or 1.4

		-- Panel stays hidden until the intro hands over. CreateWindow runs
		-- inside one frame, so this lands before anything is drawn.
		root.Visible = false

		local intro = Create("Frame", {
			Name = "Intro",
			Size = UDim2.new(0, 210, 0, 150),
			Position = UDim2.new(0.5, 0, 0.5, 0),
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundColor3 = Theme.Background,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Parent = gui,
		})
		Corner(10, intro)

		local introStroke = Stroke(intro, Theme.StrokeOuter, 1.3)
		introStroke.Transparency = 1

		local introScale = Create("UIScale", { Scale = 0.92, Parent = intro })

		local introLogo = Create("ImageLabel", {
			Name = "Logo",
			Size = UDim2.new(0, 64, 0, 64),
			Position = UDim2.new(0.5, 0, 0, 52),
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundTransparency = 1,
			Image = opts.Icon or "rbxassetid://109016122612441",
			ImageColor3 = Theme.Accent,
			ImageTransparency = 1,
			Parent = intro,
		})
		AccentGradient(introLogo)

		local introMark = Create("TextLabel", {
			Name = "Wordmark",
			Size = UDim2.new(1, -24, 0, 16),
			Position = UDim2.new(0.5, 0, 0, 104),
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundTransparency = 1,
			Text = Track(opts.Title or "SATURN"),
			TextColor3 = Theme.TextPrimary,
			TextTransparency = 1,
			TextSize = 13,
			FontFace = FONT_MED,
			Parent = intro,
		})

		-- Same bar the notifications use, run in reverse: it grows out from
		-- the centre instead of shrinking into it.
		local introBar = Create("Frame", {
			Name = "Progress",
			Size = UDim2.new(0, 0, 0, 2),
			Position = UDim2.new(0.5, 0, 0, 129),
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundColor3 = Theme.Accent,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Parent = intro,
		})
		Corner(1, introBar)
		Create("UIGradient", {
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0,   1),
				NumberSequenceKeypoint.new(0.5, 0),
				NumberSequenceKeypoint.new(1,   1),
			}),
			Parent = introBar,
		})

		local parts = {
			{ intro,       "BackgroundTransparency", 0 },
			{ introStroke, "Transparency",           0 },
			{ introLogo,   "ImageTransparency",      0 },
			{ introMark,   "TextTransparency",       0 },
			{ introBar,    "BackgroundTransparency", 0 },
		}

		local function fade(hidden, info)
			for _, p in ipairs(parts) do
				Tween(p[1], info, { [p[2]] = hidden and 1 or p[3] })
			end
		end

		task.spawn(function()
			fade(false, SMOOTH)
			Tween(introScale, OPEN_POP, { Scale = 1 })
			Tween(introBar, TweenInfo.new(dur, Enum.EasingStyle.Linear),
				{ Size = UDim2.new(1, -56, 0, 2) })

			task.wait(dur + 0.12)
			if not intro.Parent then return end

			fade(true, FADE)
			Tween(introScale, TweenInfo.new(0.26, Enum.EasingStyle.Quad,
				Enum.EasingDirection.In), { Scale = 0.96 })

			-- Panel arrives while the intro is still fading, so the two
			-- overlap rather than reading as two separate beats.
			task.wait(0.14)
			if not root.Parent then return end
			root.Visible = true
			scale.Scale = 0.92
			Tween(scale, OPEN_POP, { Scale = 1 })

			task.wait(0.3)
			intro:Destroy()
		end)
	end

	return self_
end

return Saturn
