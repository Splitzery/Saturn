	-- Starfield on the panel's own dark backdrop. Parented inside body so the
	-- CanvasGroup clips it to the rounded corners, and created after the
	-- backdrop so it layers above the fill but under everything else.
	-- Twinkles are looping TweenService tweens: no per-frame Lua.
	local starfield = Create("Frame", {
		Name = "Starfield",
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		ZIndex = 0,
		Parent = body,
	})

	do
		local rng = Random.new()

		-- Jittered grid over the sidebar column: pure random clumps, and
		-- clumping reads as an artifact rather than as texture. The page well
		-- is opaque, so there is no point placing anything behind it.
		local COLS, ROWS = 2, 7
		local X0, XSPAN = 0.02, 0.26
		local Y0, YSPAN = 0.06, 0.88

		for cx = 0, COLS - 1 do
			for cy = 0, ROWS - 1 do
				local x = X0 + (cx + rng:NextNumber(0.15, 0.85)) / COLS * XSPAN
				local y = Y0 + (cy + rng:NextNumber(0.15, 0.85)) / ROWS * YSPAN

				Twinkle(starfield, x, y, rng, 0.90, 0.96, 0.10, 0.19)
			end
		end

		-- Shooting stars fall down the column, one coroutine that sleeps.
		task.spawn(function()
			while starfield.Parent do
				task.wait(rng:NextNumber(8, 18))
				if not starfield.Parent then break end

				local fx = rng:NextNumber(0.0, 0.18)
				local fy = rng:NextNumber(-0.05, 0.35)

				local streak = Create("Frame", {
					Name = "ShootingStar",
					Size = UDim2.new(0, 0, 0, 2),
					Position = UDim2.new(fx, 0, fy, 0),
					AnchorPoint = Vector2.new(0.5, 0.5),
