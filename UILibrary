function Tab:AddSlider(opts)
	opts = opts or {}
	local min      = opts.Min or 0
	local max      = opts.Max or 100
	local decimals = opts.Decimals or 0
	local value    = math.clamp(opts.Default or min, min, max)

	-- Bar overhangs the title top and the rail bottom by the same 3px.
	local OVER    = 3
	local TRACK_H = 6
	local H       = 84
	local BAR_Y   = 14
	local TITLE_Y = BAR_Y + OVER                          -- 17
	local DESC_Y  = TITLE_Y + 20                          -- 37
	local TRACK_Y = DESC_Y + 24                           -- 61
	local BAR_H   = (TRACK_Y + TRACK_H + OVER) - BAR_Y    -- 56

	local frame, design = BaseElement(
		self.Page, opts.Name or "Slider", opts.Description, H,
		{ Y = BAR_Y, H = BAR_H }, 111)
	local conns = self:_conns()

	frame.Title.Position          = UDim2.new(0, 29, 0, TITLE_Y)
	frame.Description.Position    = UDim2.new(0, 29, 0, DESC_Y)
	frame.Description.Size        = UDim2.new(1, -140, 0, 14)
	frame.Description.TextWrapped = false
	frame.Description.TextTruncate = Enum.TextTruncate.AtEnd

	local readout = Create("TextBox", {
		Name = "Value",
		Size = UDim2.new(0, 70, 0, 16),
		Position = UDim2.new(1, -99, 0, DESC_Y - 1),
		BackgroundTransparency = 1,
		Text = tostring(value),
		TextColor3 = Theme.TextMuted,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Right,
		FontFace = FONT_MED,
		ClearTextOnFocus = false,
		Parent = frame,
	})

	local track = Create("Frame", {
		Name = "SlideContainer",
		Size = UDim2.new(1, -58, 0, TRACK_H),
		Position = UDim2.new(0, 29, 0, TRACK_Y),
		BackgroundColor3 = Theme.Panel,
		BorderSizePixel = 0,
		Active = false,
		Parent = frame,
	})
	Corner(3, track)
	Stroke(track, Theme.Stroke, 1.1)

	local fill = Create("Frame", {
		Name = "SlideFill",
		Size = UDim2.new(0, 0, 1, 0),
		BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0,
		Parent = track,
	})
	Corner(3, fill)
	AccentGradient(fill)

	local knob = Create("Frame", {
		Name = "SliderEndButton",
		Size = UDim2.new(0, 6, 0, 14),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BorderSizePixel = 0,
		ZIndex = 3,
		Parent = track,
	})
	Corner(3, knob)

	-- Invisible grab area: 24px tall, 8px past each end of the rail.
	local hitbox = Create("Frame", {
		Name = "SlideHitbox",
		Size = UDim2.new(1, -42, 0, 24),
		Position = UDim2.new(0, 21, 0, TRACK_Y - 9),
		BackgroundTransparency = 1,
		Active = true,
		ZIndex = 4,
		Parent = frame,
	})

	-- Sparks that trail off the knob while dragging.
	local SPARK_LIFE  = 0.55
	local SPARK_TWEEN = TweenInfo.new(SPARK_LIFE, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
	local lastSpark, lastAlpha = 0, nil

	local function emitSparks(alpha, direction)
		local now = os.clock()
		if now - lastSpark < 0.05 then return end   -- throttle, keeps it calm
		lastSpark = now

		for _ = 1, math.random(1, 2) do
			local dot = Create("Frame", {
				Name = "Spark",
				Size = UDim2.new(0, 3, 0, 3),
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.new(alpha, 0, 0.5, 0),
				BackgroundColor3 = Color3.fromRGB(255, 255, 255),
				BackgroundTransparency = 0.4,
				BorderSizePixel = 0,
				ZIndex = 5,
				Parent = track,
			})
			Create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = dot })

			local dx = -direction * math.random(10, 26)
			local dy = math.random(-13, 13)

			local t = Tween(dot, SPARK_TWEEN, {
				Position = UDim2.new(alpha, dx, 0.5, dy),
				Size = UDim2.new(0, 1, 0, 1),
				BackgroundTransparency = 1,
			})
			t.Completed:Connect(function() dot:Destroy() end)
		end
	end

	local api = { Instance = frame }

	function api:Set(v, silent)
		value = round(math.clamp(v, min, max), decimals)
		local alpha = (max == min) and 0 or (value - min) / (max - min)
		fill.Size     = UDim2.new(alpha, 0, 1, 0)
		knob.Position = UDim2.new(alpha, 0, 0.5, 0)
		if not readout:IsFocused() then
			readout.Text = tostring(value) .. (opts.Suffix or "")
		end
		if not silent and opts.Callback then task.spawn(opts.Callback, value) end
	end

	function api:Get() return value end

	BindHorizontalDrag(hitbox, function(alpha)
		local dir = 0
		if lastAlpha then
			local d = alpha - lastAlpha
			if math.abs(d) > 0.0005 then
				dir = (d > 0) and 1 or -1
			end
		end
		lastAlpha = alpha

		api:Set(min + (max - min) * alpha)

		if dir ~= 0 then
			emitSparks(alpha, dir)
		end
	end, conns, track)

	readout.Focused:Connect(function()
		readout.TextColor3 = Theme.Accent
	end)

	readout.FocusLost:Connect(function()
		readout.TextColor3 = Theme.TextMuted
		local typed = tonumber(readout.Text:match("%-?%d+%.?%d*") or "")
		if typed then
			api:Set(typed)
		end
		readout.Text = tostring(value) .. (opts.Suffix or "")
	end)

	function api:SetDisabled(state) ApplyDisabled(frame, state) end
	function api:Destroy() DisconnectAll(conns) frame:Destroy() end

	api:Set(value, true)
	self:_register(opts.Flag, function() return value end,
		function(v) api:Set(v, true) end)
	self:_onInit(function() return value end, opts)
	return api
end

function Tab:AddTextBox(opts)
	opts = opts or {}
	local frame = BaseElement(self.Page, opts.Name or "TextBox", opts.Description, nil, nil, 172)
	local conns = self:_conns()

	local PAD      = 8     -- matches the ~7.5px the 13px text leaves top and bottom
	local MIN_W    = 103
	local HARD_MAX = 150

	local box = Create("TextBox", {
		Name = "Input",
		Size = UDim2.new(0, MIN_W, 0, 28),
		Position = UDim2.new(1, -10, 0.5, 0),
		AnchorPoint = Vector2.new(1, 0.5),      -- pinned right, so it grows leftward
		BackgroundColor3 = Theme.Panel,
		BorderSizePixel = 0,
		ClipsDescendants = true,                -- clips the text to the box
		Text = opts.Default or "",
		TextColor3 = Theme.TextBright,
		TextSize = 13,
		TextScaled = false,
		TextWrapped = false,
		TextXAlignment = Enum.TextXAlignment.Right,
		FontFace = FONT_MED,
		PlaceholderText = opts.Placeholder or "Type Input Here...",
		PlaceholderColor3 = Theme.TextFaint,
		ClearTextOnFocus = false,
		Parent = frame,
	})
	Corner(10, box)
	Create("UIPadding", {
		PaddingLeft  = UDim.new(0, PAD),
		PaddingRight = UDim.new(0, PAD),
		Parent = box,
	})
	local bs = Stroke(box, Theme.Stroke, 1.1)
	AccentGradient(bs)   -- UIGradient shades a UIStroke the same way it does a fill

	-- Grow to fit the text, but never past the description or the right margin.
	local function fit()
		local descRight = 29 + frame.Description.AbsoluteSize.X
		local available = frame.AbsoluteSize.X - 10 - descRight - 12
		local maxW = math.clamp(math.min(HARD_MAX, available), MIN_W, HARD_MAX)
		local want = math.clamp(box.TextBounds.X + PAD * 2 + 4, MIN_W, maxW)
		Tween(box, GROW, { Size = UDim2.new(0, want, 0, 28) })
	end

	box:GetPropertyChangedSignal("TextBounds"):Connect(fit)
	frame:GetPropertyChangedSignal("AbsoluteSize"):Connect(fit)
	fit()

	local committed = box.Text

	box.Focused:Connect(function()
		Tween(bs, FAST, { Color = Theme.Accent })
	end)

	box.FocusLost:Connect(function(enterPressed)
		Tween(bs, FAST, { Color = Theme.Stroke })
		if box.Text == committed then return end
		committed = box.Text
		if opts.Callback then task.spawn(opts.Callback, box.Text, enterPressed) end
	end)

	local function silentSet(v)
		box.Text = tostring(v or "")
		committed = box.Text
	end

	self:_register(opts.Flag, function() return box.Text end, silentSet)
	self:_onInit(function() return box.Text end, opts)

	return {
		Instance = frame,
		Set = function(_, v) silentSet(v) end,
		Get = function() return box.Text end,
		SetDisabled = function(_, state) ApplyDisabled(frame, state) end,
		Destroy = function() DisconnectAll(conns) frame:Destroy() end,
	}
end

function Tab:AddKeybind(opts)
	opts = opts or {}
	local mode = opts.Mode or "Press"   -- Press | Toggle | Hold
	local held = false

	local frame = BaseElement(self.Page, opts.Name or "Keybind", opts.Description, nil, nil, 107)
	local conns = self:_conns()

	local display = Create("TextLabel", {
		Name = "KeybindBox",
		Size = UDim2.new(0, 85, 0, 28),
		Position = UDim2.new(1, -95, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundColor3 = Theme.Panel,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Text = "None",
		TextColor3 = Theme.TextFaint,
		TextSize = 13,
		TextTruncate = Enum.TextTruncate.AtEnd,
		FontFace = FONT_MED,
		ZIndex = 10,          -- its click layer has to beat the card's
		Parent = frame,
	})
	Corner(10, display)
	local ks = Stroke(display, Theme.Stroke, 1.1)
	AccentGradient(ks)

	-- Shared by the bound key and by tapping the card, so a phone can still
	-- run the action even though it has no key to press.
	local function activate(k)
		if mode == "Toggle" then
			held = not held
			if opts.Callback then task.spawn(opts.Callback, held) end
		elseif mode == "Hold" then
			if held then return end
			held = true
			if opts.Callback then task.spawn(opts.Callback, true) end
		else
			if opts.Callback then task.spawn(opts.Callback, k) end
		end
	end

	local function release()
		if mode == "Hold" and held then
			held = false
			if opts.Callback then task.spawn(opts.Callback, false) end
		end
	end

	-- The box rebinds; the rest of the card fires.
	local binding = AttachBinding(ClickLayer(display, 10), display, ks, conns,
		opts.Default, activate, opts.OnBind)

	if opts.TapToFire ~= false then
		local fire = ClickLayer(frame)
		fire.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
				activate(binding.Get())
			end
		end)
		fire.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
				release()
			end
		end)
	end

	-- Hold mode needs the key's release edge too.
	table.insert(conns, UserInputService.InputEnded:Connect(function(input)
		local k = binding.Get()
		if k and input.KeyCode == k then release() end
	end))

	self:_register(opts.Flag, binding.Get, binding.Set)

	return {
		Instance = frame,
		Get = binding.Get,
		Set = function(_, k) binding.Set(k) end,
		Fire = function() activate(binding.Get()) end,
		GetState = function() return held end,
		SetDisabled = function(_, state) ApplyDisabled(frame, state) end,
		Destroy = function() DisconnectAll(conns) frame:Destroy() end,
	}
end

function Tab:AddColorPicker(opts)
	opts = opts or {}
	local current = opts.Default or Theme.Accent
	local hue, sat, val = 0, 1, 1
	local open = false

	-- Open layout:
	--   title 14-32 / desc 35-49 / SV 59-119 / hue 129-143 / inputs 153-177
	--   Bar spans 15-180. It clears the title glyphs by ~3px at the top, so it
	--   clears the input row by 3px at the bottom to read as even.
	local SV_Y, SV_H       = 59, 60
	local HUE_Y, HUE_H     = 129, 14
	local INPUT_Y, INPUT_H = 153, 24
	local DESIGN_CLOSED, DESIGN_OPEN = 34, 165

	local frame, design = BaseElement(
		self.Page, opts.Name or "ColorPicker", opts.Description, nil, nil, 58, true)

	-- SetAccent matches "Design"; keep this one out of it so the tint sticks.
	design.Name = "DesignPicker"
	local conns = self:_conns()
	local designShadow = design:FindFirstChildOfClass("UIShadow")

	frame.Description.Size         = UDim2.new(1, -87, 0, 14)
	frame.Description.TextWrapped  = false
	frame.Description.TextTruncate = Enum.TextTruncate.AtEnd

	local swatch = Create("ImageLabel", {
		Name = "Swatch",
		Size = UDim2.new(0, 28, 0, 28),
		Position = UDim2.new(1, -46, 0, 18),
		BackgroundTransparency = 1,
		Image = opts.Icon or "rbxassetid://75657875916273",
		ImageColor3 = current,
		Parent = frame,
	})
	AccentGradient(swatch)

	-- ---------- saturation / value area ----------

	local svArea = Create("Frame", {
		Name = "SVArea",
		Size = UDim2.new(1, -58, 0, SV_H),
		Position = UDim2.new(0, 29, 0, SV_Y),
		BackgroundColor3 = Color3.fromRGB(255, 0, 0),
		BorderSizePixel = 0,
		Visible = false,
		Parent = frame,
	})
	Corner(4, svArea)
	Stroke(svArea, Theme.Stroke, 1.1)

	-- White, solid at the left, transparent at the right.
	local whiteLayer = Create("Frame", {
		Name = "WhiteLayer",
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BorderSizePixel = 0,
		Parent = svArea,
	})
	Corner(4, whiteLayer)
	Create("UIGradient", {
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Parent = whiteLayer,
	})

	-- Black, transparent at the top, solid at the bottom.
	local blackLayer = Create("Frame", {
		Name = "BlackLayer",
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundColor3 = Color3.fromRGB(0, 0, 0),
		BorderSizePixel = 0,
		Parent = svArea,
	})
	Corner(4, blackLayer)
	Create("UIGradient", {
		Rotation = 90,
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(1, 0),
		}),
		Parent = blackLayer,
	})

	local svMarker = Create("Frame", {
		Name = "SVMarker",
		Size = UDim2.new(0, 14, 0, 14),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, 0, 0, 0),
		BackgroundColor3 = current,
		BorderSizePixel = 0,
		ZIndex = 5,
		Parent = svArea,
	})
	Corner(7, svMarker)
	Stroke(svMarker, Color3.fromRGB(255, 255, 255), 2)

	-- Dark outer ring so the marker stays visible in the white corner.
	local svRing = Create("Frame", {
		Name = "Ring",
		Size = UDim2.new(1, 6, 1, 6),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		Parent = svMarker,
	})
	Corner(10, svRing)
	Stroke(svRing, Theme.Background, 1.5)

	local svHit = Create("Frame", {
		Name = "SVHitbox",
		Size = UDim2.new(1, -42, 0, 73),
		Position = UDim2.new(0, 21, 0, 51),
		BackgroundTransparency = 1,
		Visible = false,
		Active = true,
		ZIndex = 4,
		Parent = frame,
	})

	-- ---------- hue rail ----------

	local hueBar = Create("Frame", {
		Name = "ColorGradient",
		Size = UDim2.new(1, -58, 0, HUE_H),
		Position = UDim2.new(0, 29, 0, HUE_Y),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BorderSizePixel = 0,
		Visible = false,
		Parent = frame,
	})
	Corner(4, hueBar)
	Stroke(hueBar, Theme.Stroke, 1.1)
	Create("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0.000, Color3.fromRGB(255, 0, 0)),
			ColorSequenceKeypoint.new(0.175, Color3.fromRGB(255, 255, 0)),
			ColorSequenceKeypoint.new(0.350, Color3.fromRGB(0, 255, 0)),
			ColorSequenceKeypoint.new(0.525, Color3.fromRGB(0, 255, 255)),
			ColorSequenceKeypoint.new(0.700, Color3.fromRGB(0, 0, 255)),
			ColorSequenceKeypoint.new(0.875, Color3.fromRGB(255, 0, 255)),
			ColorSequenceKeypoint.new(1.000, Color3.fromRGB(255, 0, 0)),
		}),
		Parent = hueBar,
	})

	local hueMarker = Create("Frame", {
		Name = "PickerBar",
		Size = UDim2.new(0, 6, 0, HUE_H + 6),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BorderSizePixel = 0,
		ZIndex = 3,
		Parent = hueBar,
	})
	Corner(3, hueMarker)
	Stroke(hueMarker, Theme.Background, 1.2)

	local hueHit = Create("Frame", {
		Name = "HueHitbox",
		Size = UDim2.new(1, -42, 0, 20),
		Position = UDim2.new(0, 21, 0, HUE_Y - 3),
		BackgroundTransparency = 1,
		Visible = false,
		Active = true,
		ZIndex = 4,
		Parent = frame,
	})

	-- ---------- hex / rgb inputs ----------

	local inputRow = Create("Frame", {
		Name = "InputRow",
		Size = UDim2.new(1, -58, 0, INPUT_H),
		Position = UDim2.new(0, 29, 0, INPUT_Y),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = frame,
	})

	local function makeField(name, pos, size)
		local box = Create("TextBox", {
			Name = name,
			Size = size,
			Position = pos,
			BackgroundColor3 = Theme.Panel,
			BorderSizePixel = 0,
			ClipsDescendants = true,
			Text = "",
			TextColor3 = Theme.TextBright,
			TextSize = 13,
			FontFace = FONT_MED,
			ClearTextOnFocus = false,
			Parent = inputRow,
		})
		Corner(8, box)
		local s = Stroke(box, Theme.Stroke, 1.1)
		box.Focused:Connect(function() Tween(s, FAST, { Color = Theme.Accent }) end)
		box.FocusLost:Connect(function() Tween(s, FAST, { Color = Theme.Stroke }) end)
		return box
	end

	-- Three 52px channels pinned right, hex fills what's left.
	local hexBox = makeField("Hex", UDim2.new(0, 0, 0, 0),    UDim2.new(1, -176, 1, 0))
	local rBox   = makeField("R",   UDim2.new(1, -168, 0, 0), UDim2.new(0, 52, 1, 0))
	local gBox   = makeField("G",   UDim2.new(1, -110, 0, 0), UDim2.new(0, 52, 1, 0))
	local bBox   = makeField("B",   UDim2.new(1, -52,  0, 0), UDim2.new(0, 52, 1, 0))

	local function toHex(c)
		return string.format("#%02X%02X%02X",
			math.round(c.R * 255), math.round(c.G * 255), math.round(c.B * 255))
	end

	local function parseHex(s)
		s = s:gsub("[^%x]", "")
		if #s == 3 then
			s = s:sub(1, 1):rep(2) .. s:sub(2, 2):rep(2) .. s:sub(3, 3):rep(2)
		end
		if #s ~= 6 then return nil end
		local n = tonumber(s, 16)
		if not n then return nil end
		return Color3.fromRGB(math.floor(n / 65536) % 256, math.floor(n / 256) % 256, n % 256)
	end

	local function refreshFields(c)
		if not hexBox:IsFocused() then hexBox.Text = toHex(c) end
		if not rBox:IsFocused()   then rBox.Text = "R " .. math.round(c.R * 255) end
		if not gBox:IsFocused()   then gBox.Text = "G " .. math.round(c.G * 255) end
		if not bBox:IsFocused()   then bBox.Text = "B " .. math.round(c.B * 255) end
	end

	-- ---------- colour plumbing ----------

	-- HSV is the single source of truth, so hex/RGB round-trip exactly.
	local function refresh(silent)
		local c = Color3.fromHSV(hue, sat, val)
		current = c

		svArea.BackgroundColor3   = Color3.fromHSV(hue, 1, 1)
		svMarker.BackgroundColor3 = c
		svMarker.Position  = UDim2.new(sat, 0, 1 - val, 0)
		hueMarker.Position = markerPos(hue, hueBar)
		swatch.ImageColor3 = c
		refreshFields(c)

		if open then
			-- Floor the value so near-black picks don't vanish into the card.
			local barColor = Color3.fromHSV(hue, sat, math.max(val, 0.4))
			design.BackgroundColor3 = barColor
			if designShadow then
				pcall(function() designShadow.Color = barColor end)
			end
		end

		if not silent and opts.Callback then task.spawn(opts.Callback, c) end
	end

	local function setColor(c, silent)
		hue, sat, val = Color3.toHSV(c)
		refresh(silent)
	end

	BindAreaDrag(svHit, function(x, y)
		sat, val = x, 1 - y
		refresh()
	end, conns, svArea)

	BindHorizontalDrag(hueHit, function(a)
		hue = a
		refresh()
	end, conns, hueBar)

	hexBox.FocusLost:Connect(function()
		local c = parseHex(hexBox.Text)
		if c then setColor(c) else refreshFields(current) end
	end)

	local function channelCommit()
		local r = tonumber(rBox.Text:match("%d+") or "")
		local g = tonumber(gBox.Text:match("%d+") or "")
		local b = tonumber(bBox.Text:match("%d+") or "")
		if r and g and b then
			setColor(Color3.fromRGB(
				math.clamp(r, 0, 255), math.clamp(g, 0, 255), math.clamp(b, 0, 255)))
		else
			refreshFields(current)
		end
	end

	rBox.FocusLost:Connect(channelCommit)
	gBox.FocusLost:Connect(channelCommit)
	bBox.FocusLost:Connect(channelCommit)

	-- ---------- open / close ----------

	-- Scroll the page so the whole expanded picker is visible.
	local page = self.Page

	local function revealIfNeeded()
		if not page.Parent then return end
		local top    = frame.AbsolutePosition.Y - page.AbsolutePosition.Y + page.CanvasPosition.Y
		local bottom = top + PICKER_H + 6
		local target = math.max(0, bottom - page.AbsoluteSize.Y)
		if target > page.CanvasPosition.Y + 0.5 then
			Tween(page, SMOOTH, { CanvasPosition = Vector2.new(0, target) })
		end
	end

	-- Ripple host stays full-height so it grows with the frame; only the button
	-- is capped to the header strip. The hint sizes the circle for the state
	-- we're about to enter, so expanding flows straight down into the new area.
	local click = ClickLayer(frame, 10, function()
		return open and ELEMENT_H or PICKER_H
	end)
	click.Size = UDim2.new(1, 0, 0, 50)   -- stops short of the SV hitbox at y=51

	click.MouseButton1Click:Connect(function()
		open = not open
		svArea.Visible, hueBar.Visible, inputRow.Visible = open, open, open
		svHit.Visible, hueHit.Visible = open, open
		Tween(frame, SMOOTH, { Size = UDim2.new(1, -8, 0, open and PICKER_H or ELEMENT_H) })
		Tween(design, SMOOTH, { Size = UDim2.new(0, 4, 0, open and DESIGN_OPEN or DESIGN_CLOSED) })

		if open then
			refresh(true)         -- tint the bar to the current colour
			revealIfNeeded()
		else
			Tween(design, SMOOTH, { BackgroundColor3 = Theme.Accent })
			if designShadow then
				pcall(function() designShadow.Color = Theme.Accent end)
			end
		end

		task.delay(0.3, function()
			hueMarker.Position = markerPos(hue, hueBar)
			if open then revealIfNeeded() end
		end)
	end)

	setColor(current, true)
	self:_register(opts.Flag, function() return current end,
		function(c) setColor(c, true) end)
	self:_onInit(function() return current end, opts)

	return {
		Instance = frame,
		Get = function() return current end,
		Set = function(_, c) setColor(c, true) end,
		SetDisabled = function(_, state) ApplyDisabled(frame, state) end,
		Destroy = function() DisconnectAll(conns) frame:Destroy() end,
	}
end

local function buildDropdown(self, opts, multi)
	local options = opts.Options or {}
	local open    = false

	local ROW_H, ROW_GAP, MAX_VISIBLE = 26, 2, 4

	-- A filter box appears automatically once the list gets long.
	local hasSearch
	if opts.Search ~= nil then
		hasSearch = opts.Search
	else
		hasSearch = #options > 8
	end
	local LIST_Y = hasSearch and 93 or 59

	-- Selection is always stored as an ordered list, even in single mode.
	local selected = {}
	do
		local d = opts.Default
		if type(d) == "table" then
			for _, v in ipairs(d) do table.insert(selected, v) end
		elseif d ~= nil then
			table.insert(selected, d)
		end
		if not multi and #selected > 1 then
			selected = { selected[1] }
		end

		-- A default that isn't in Options would show a value you can't reselect.
		local valid = {}
		for _, v in ipairs(selected) do
			for _, o in ipairs(options) do
				if o == v then
					table.insert(valid, v)
					break
				end
			end
		end
		if #valid ~= #selected then
			warn(("[Saturn] dropdown %q: Default contains values not in Options")
				:format(tostring(opts.Name or "?")))
		end
		selected = valid
	end

	local frame, design = BaseElement(
		self.Page, opts.Name or "Dropdown", opts.Description, nil, nil, 132, true)
	local conns = self:_conns()

	frame.Description.Size         = UDim2.new(1, -161, 0, 14)
	frame.Description.TextWrapped  = false
	frame.Description.TextTruncate = Enum.TextTruncate.AtEnd

	local choose, setOpen   -- forward declarations, rows reference both

	local function listHeight()
		local n = math.max(#options, 1)
		return math.min(n, MAX_VISIBLE) * (ROW_H + ROW_GAP) - ROW_GAP
	end

	local function openHeight()
		return LIST_Y + listHeight() + 18
	end

	local function isChosen(v)
		for _, s in ipairs(selected) do
			if s == v then return true end
		end
		return false
	end

	local function displayText()
		if #selected == 0 then return opts.Placeholder or "None" end
		if not multi then return tostring(selected[1]) end
		if #selected <= 2 then return table.concat(selected, ", ") end
		return #selected .. " selected"
	end

	-- ---------- closed control ----------

	local display = Create("TextLabel", {
		Name = "DropdownBox",
		Size = UDim2.new(0, 110, 0, 28),
		Position = UDim2.new(1, -10, 0, 32),   -- header row, fixed: the frame grows below it
		AnchorPoint = Vector2.new(1, 0.5),
		BackgroundColor3 = Theme.Panel,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Text = displayText(),
		TextColor3 = (#selected > 0) and Theme.TextBright or Theme.TextFaint,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		FontFace = FONT_MED,
		Parent = frame,
	})
	Corner(10, display)
	Stroke(display, Theme.Stroke, 1.1)
	Create("UIPadding", {
		PaddingLeft  = UDim.new(0, 10),
		PaddingRight = UDim.new(0, 26),   -- clearance for the chevron
		Parent = display,
	})

	-- Two rotated bars: renders identically everywhere, no glyph or asset needed.
	local chevron = Create("Frame", {
		Name = "Chevron",
		Size = UDim2.new(0, 12, 0, 12),
		Position = UDim2.new(1, -20, 0, 32),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		Parent = frame,
	})
	for _, spec in ipairs({ { 3, 45 }, { 9, -45 } }) do
		local bar = Create("Frame", {
			Size = UDim2.new(0, 8, 0, 2),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0, spec[1], 0.5, 0),
			Rotation = spec[2],
			BackgroundColor3 = Theme.TextMuted,
			BorderSizePixel = 0,
			Parent = chevron,
		})
		Corner(1, bar)
	end

	-- ---------- option list ----------

	local search
	if hasSearch then
		search = Create("TextBox", {
			Name = "Search",
			Size = UDim2.new(1, -58, 0, 26),
			Position = UDim2.new(0, 29, 0, 59),
			BackgroundColor3 = Theme.Panel,
			BorderSizePixel = 0,
			ClipsDescendants = true,
			Visible = false,
			Text = "",
			TextColor3 = Theme.TextBright,
			TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Left,
			FontFace = FONT_MED,
			PlaceholderText = "Search...",
			PlaceholderColor3 = Theme.TextFaint,
			ClearTextOnFocus = false,
			Parent = frame,
		})
		Corner(8, search)
		Stroke(search, Theme.Stroke, 1.1)
		Create("UIPadding", {
			PaddingLeft = UDim.new(0, 10),
			PaddingRight = UDim.new(0, 10),
			Parent = search,
		})
	end

	local list = Create("ScrollingFrame", {
		Name = "OptionList",
		Size = UDim2.new(1, -58, 0, listHeight()),
		Position = UDim2.new(0, 29, 0, LIST_Y),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Visible = false,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		ScrollBarThickness = 2,
		ScrollBarImageColor3 = Theme.Stroke,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = frame,
	})
	Create("UIListLayout", {
		Padding = UDim.new(0, ROW_GAP),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = list,
	})

	local rows = {}

	local function paintRows()
		for _, r in ipairs(rows) do
			local on = isChosen(r.value)
			Tween(r.row,   FAST, { BackgroundColor3 = on and Theme.TabActive or Theme.Panel })
			Tween(r.label, FAST, { TextColor3 = on and Theme.TextPrimary or Theme.TextMuted })
			Tween(r.mark, on and SEL_GROW or SEL_SHRINK,
				{ Size = UDim2.new(0, 3, 0, on and 12 or 0) })
		end
	end

	local function applyFilter()
		local q = search and string.lower(search.Text) or ""
		for _, r in ipairs(rows) do
			r.row.Visible = (q == "")
				or (string.find(string.lower(tostring(r.value)), q, 1, true) ~= nil)
		end
	end

	-- Multi only: press and sweep to paint a run of rows. The range is
	-- anchor..current, and everything outside it snaps back to how it was
	-- when the drag started -- so sweeping back undoes as you go.
	local painting, paintMode, anchorIdx, baseline = false, false, nil, nil

	local function applyRange(toIdx)
		local lo = math.min(anchorIdx, toIdx)
		local hi = math.max(anchorIdx, toIdx)

		selected = {}
		for i, r in ipairs(rows) do
			local want
			if r.row.Visible and i >= lo and i <= hi then
				want = paintMode
			else
				want = baseline[r.value] or false
			end
			if want then table.insert(selected, r.value) end
		end

		display.Text = displayText()
		display.TextColor3 = (#selected > 0) and Theme.TextBright or Theme.TextFaint
		paintRows()
	end

	local function beginPaint(idx)
		if not rows[idx] then return end
		painting  = true
		-- Otherwise a touch sweep scrolls the list instead of painting.
		list.ScrollingEnabled = false
		anchorIdx = idx
		baseline  = {}
		for _, r in ipairs(rows) do
			baseline[r.value] = isChosen(r.value)
		end
		-- Paint the opposite of whatever the row you grabbed was.
		paintMode = not baseline[rows[idx].value]
		applyRange(idx)
	end

	local function endPaint()
		if not painting then return end
		painting = false
		list.ScrollingEnabled = true
		if opts.Callback then
			task.spawn(opts.Callback, table.clone(selected))
		end
	end

	local function makeRow(value, index)
		local row = Create("Frame", {
			Name = "Option",
			Size = UDim2.new(1, -6, 0, ROW_H),
			BackgroundColor3 = Theme.Panel,
			BorderSizePixel = 0,
			LayoutOrder = index,
			Parent = list,
		})
		Corner(8, row)

		local label = Create("TextLabel", {
			Name = "Label",
			Size = UDim2.new(1, -30, 1, 0),
			Position = UDim2.new(0, 10, 0, 0),
			BackgroundTransparency = 1,
			Text = tostring(value),
			TextColor3 = Theme.TextMuted,
			TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			FontFace = FONT_MED,
			Parent = row,
		})

		-- Same accent tick the sidebar tabs use, grown from the centre.
		local mark = Create("Frame", {
			Name = "Mark",
			Size = UDim2.new(0, 3, 0, 0),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(1, -8, 0.5, 0),
			BackgroundColor3 = Theme.Accent,
			BorderSizePixel = 0,
			Parent = row,
		})
		Corner(2, mark)
		AccentGradient(mark)

		local layer = ClickLayer(row, 8)

		if multi then
			-- A plain click is just a one-row sweep, so choose() is not needed.
			layer.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
					beginPaint(index)
				end
			end)
			-- Row tracking is a hit test in the global handler below, so it works
			-- for touch and does not skip rows on a fast sweep.
		else
			layer.MouseButton1Click:Connect(function()
				choose(value)
			end)
		end

		return { row = row, label = label, mark = mark, value = value }
	end

	-- ---------- open / close ----------

	local page = self.Page

	local function revealIfNeeded()
		if not page.Parent then return end
		local top    = frame.AbsolutePosition.Y - page.AbsolutePosition.Y + page.CanvasPosition.Y
		local bottom = top + openHeight() + 6
		local target = math.max(0, bottom - page.AbsoluteSize.Y)
		if target > page.CanvasPosition.Y + 0.5 then
			Tween(page, SMOOTH, { CanvasPosition = Vector2.new(0, target) })
		end
	end

	setOpen = function(state)
		open = state
		list.Visible = state
		if search then search.Visible = state end
		local h = state and openHeight() or ELEMENT_H
		Tween(frame,  SMOOTH, { Size = UDim2.new(1, -8, 0, h) })
		Tween(design, SMOOTH, { Size = UDim2.new(0, 4, 0, h - 30) })
		Tween(chevron, SMOOTH, { Rotation = state and 180 or 0 })
		if state then revealIfNeeded() end
	end

	choose = function(value)
		if multi then
			local removed = false
			for i, s in ipairs(selected) do
				if s == value then
					table.remove(selected, i)
					removed = true
					break
				end
			end
			if not removed then table.insert(selected, value) end
		else
			selected = { value }
		end

		display.Text = displayText()
		display.TextColor3 = (#selected > 0) and Theme.TextBright or Theme.TextFaint
		paintRows()

		if opts.Callback then
			task.spawn(opts.Callback, multi and table.clone(selected) or selected[1])
		end
		if not multi then setOpen(false) end
	end

	local function rebuild(newOptions)
		if newOptions then options = newOptions end
		for _, r in ipairs(rows) do r.row:Destroy() end
		table.clear(rows)
		for i, v in ipairs(options) do
			table.insert(rows, makeRow(v, i))
		end
		list.Size = UDim2.new(1, -58, 0, listHeight())
		display.Text = displayText()
		paintRows()
		applyFilter()
		if open then setOpen(true) end   -- re-fit to the new row count
	end

	rebuild()

	if multi then
		table.insert(conns, UserInputService.InputChanged:Connect(function(input)
			if not painting then return end
			if input.UserInputType ~= Enum.UserInputType.MouseMovement
			and input.UserInputType ~= Enum.UserInputType.Touch then return end

			for i, r in ipairs(rows) do
				if r.row.Visible and InBounds(r.row, input.Position) then
					applyRange(i)
					break
				end
			end
		end))

		table.insert(conns, UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
				endPaint()
			end
		end))
	end

	if search then
		table.insert(conns, search:GetPropertyChangedSignal("Text"):Connect(applyFilter))
	end

	local click = ClickLayer(frame, 10, function()
		return open and ELEMENT_H or openHeight()
	end)
	click.Size = UDim2.new(1, 0, 0, 50)   -- header strip only; rows start at 59

	click.MouseButton1Click:Connect(function()
		setOpen(not open)
	end)

	local function silentSet(v)
		selected = {}
		if type(v) == "table" then
			for _, x in ipairs(v) do table.insert(selected, x) end
		elseif v ~= nil then
			table.insert(selected, v)
		end
		if not multi and #selected > 1 then selected = { selected[1] } end
		display.Text = displayText()
		display.TextColor3 = (#selected > 0) and Theme.TextBright or Theme.TextFaint
		paintRows()
	end

	self:_register(opts.Flag, function()
		return multi and table.clone(selected) or selected[1]
	end, silentSet)
	self:_onInit(function()
		return multi and table.clone(selected) or selected[1]
	end, opts)

	return {
		Instance = frame,
		Get = function()
			return multi and table.clone(selected) or selected[1]
		end,
		Set = function(_, v) silentSet(v) end,
		SetOptions = function(_, list2) rebuild(list2) end,
		Open = function(_, state) setOpen(state ~= false) end,
		SetDisabled = function(_, state) ApplyDisabled(frame, state) end,
		Destroy = function() DisconnectAll(conns) frame:Destroy() end,
	}
end

