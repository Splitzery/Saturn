	for _, d in ipairs(self.Gui:GetDescendants()) do
		if d.Name == "Design" or d.Name == "SelectedIcon" or d.Name == "SlideFill" then
			d.BackgroundColor3 = color
		elseif d.Name == "ToggleSwitchBG" and d.BackgroundColor3 ~= Theme.Panel then
			d.BackgroundColor3 = color
		elseif d.Name == "SaturnIcon" then
			d.ImageColor3 = color
		elseif d.ClassName == "UIShadow" and d.Parent
			and (d.Parent.Name == "Design" or d.Parent.Name == "SelectedIcon") then
			pcall(function() d.Color = color end)
		end
	end
end

-- The keybind mirrors the yellow light: collapse into the widget and back.
-- The widget itself stays on screen; only the red light removes the UI.
function Window:Toggle(state)
	if state == nil then state = self.Minimized end
	if state then
		self:Restore()
	else
		self:Minimize()
	end
end

-- Hides anything in the active page whose title does not match. Sections,
-- dividers and paragraphs drop out while a query is active.
function Window:_applySearch(query)
	local tab2 = self.ActiveTab
	if not tab2 then return end

	local q = string.lower(query or "")
	local matches = 0

	for _, child in ipairs(tab2.Page:GetChildren()) do
		if child:IsA("GuiObject") then
			if q == "" then
				child.Visible = true
			else
				local title = child:FindFirstChild("Title")
				local hit = title ~= nil
					and string.find(string.lower(title.Text), q, 1, true) ~= nil
				child.Visible = hit
				if hit then matches += 1 end
			end
		end
	end

	self:_setEmpty(q ~= "" and matches == 0, query)
end

function Window:_setEmpty(show, query)
	local e = self.EmptyState
	if not e then return end

	if show then
		self.EmptySub.Text = string.format('Nothing matches "%s"', query or "")
		e.Visible = true
		for _, p in ipairs(self.EmptyParts) do
			Tween(p[1], FADE, { [p[2]] = p[3] })
		end
	elseif e.Visible then
		for _, p in ipairs(self.EmptyParts) do
			Tween(p[1], EMPTY_OUT, { [p[2]] = 1 })
		end
		task.delay(0.1, function()
			-- Another search may have re-shown it in the meantime.
			if self.EmptyParts[2][1].TextTransparency >= 1 then
				e.Visible = false
			end
		end)
	end
end

function Window:ToggleSearch(state)
	if state == nil then state = not self.SearchOpen end
	if state == self.SearchOpen then return end
	-- Can only open what is actually on screen.
	if state and (self.Minimized or not self.SearchPeek) then return end
	self.SearchOpen = state

	local tint = state and Theme.Accent or Theme.TextMuted
	Tween(self.SearchGlass, FAST, { ImageColor3 = tint })

	if state then
		self.SearchBox.Visible = true
		Tween(self.AdjustFrame, SMOOTH, { Position = UDim2.new(0.5, -105, 0, -28) })
		Tween(self.SearchFrame, SMOOTH, {
			Position = UDim2.new(0.5, -54, 0, -28),
			Size = UDim2.new(0, 204, 0, 22),
		})
		task.delay(0.28, function()
			if self.SearchOpen then self.SearchBox:CaptureFocus() end
		end)
	else
		self.SearchBox.Text = ""
		self.SearchBox.Visible = false
		pcall(function() self.SearchBox:ReleaseFocus() end)
		self:_applySearch("")
		Tween(self.AdjustFrame, SMOOTH, { Position = UDim2.new(0.5, 0, 0, -28) })
		Tween(self.SearchFrame, SMOOTH, {
			Position = UDim2.new(0.5, 51, 0, -28),
			Size = UDim2.new(0, 26, 0, 22),
		})

		-- Back to the peek slot. Only retract if the cursor has already left.
		self.SearchPeek = true
		if self.HideSearch and self.IsHoveringWidgets
			and not self.IsHoveringWidgets() then
			self.HideSearch()
		end
	end
end

-- Closes and tucks the search regardless of hover state.
function Window:_tuckSearch()
	if self.SearchOpen then
		self.SearchOpen = false
		self.SearchBox.Text = ""
		self.SearchBox.Visible = false
		pcall(function() self.SearchBox:ReleaseFocus() end)
		self:_applySearch("")
		Tween(self.AdjustFrame, SMOOTH, { Position = UDim2.new(0.5, 0, 0, -28) })
		Tween(self.SearchGlass, FAST, { ImageColor3 = Theme.TextMuted })
	end

	self.SearchPeek = false
	Tween(self.SearchFrame, SMOOTH, {
		Position = UDim2.new(0.5, 19, 0, -28),
		Size = UDim2.new(0, 26, 0, 22),
	})
	task.delay(0.28, function()
		if not self.SearchPeek and not self.SearchOpen then
			self.SearchFrame.Visible = false
		end
	end)
end

function Window:Minimize()
	if self.Animating or self.Minimized then return end
	self.Animating = true
	self.Minimized = true

	self:_tuckSearch()

	-- The whole assembly travels: the pill stays attached to Root, so the
	-- panel rides up with it and closes at the top bar. No reparenting, and
	-- therefore no coordinate conversion to get wrong.
	self.RestorePos = self.Root.Position

	-- Root is centre-anchored, so park it where the pill (at -28 relative)
	-- lands on TOPBAR_Y.
	local h = self.Root.AbsoluteSize.Y
	Tween(self.Root, DOCK, {
		Position = UDim2.new(0.5, 0, 0, TOPBAR_Y + 28 + h / 2),
	})

	Tween(self.AdjustFrame, SLIDE, { Size = UDim2.new(0, ADJUST_W_MIN, 0, ADJUST_H) })
	Tween(self.CloseBtn,  SLIDE, { Position = UDim2.new(0, LIGHT_MIN.Close,  0.5, -6) })
	Tween(self.ExpandBtn, SLIDE, { Position = UDim2.new(0, LIGHT_MIN.Expand, 0.5, -6) })
	Tween(self.MinimizeBtn, RESTORE_FADE, { BackgroundTransparency = 1 })

	self.Body.ClipsDescendants = true
	Tween(self.Body, PANEL_SHUT, { Size = UDim2.new(1, 0, 0, 0) })

	task.delay(0.12, function()
		if self.Minimized then self.MinimizeBtn.Visible = false end
	end)

	task.delay(0.22, function()
		if not self.Body.Parent or not self.Minimized then return end
		self.Body.Visible = false
		self.Body.Size = UDim2.new(1, 0, 1, 0)
	end)

	task.delay(DOCK_TIME, function() self.Animating = false end)
end

function Window:Restore()
	if self.Animating or not self.Minimized then return end
	self.Animating = true
	self.Minimized = false

	-- Straight reverse: the assembly flies home and the panel opens on the
	-- way down, so both settle together.
	Tween(self.Root, DOCK, {
		Position = self.RestorePos or UDim2.new(0.5, 0, 0.5, 0),
	})

	Tween(self.AdjustFrame, SLIDE, { Size = UDim2.new(0, ADJUST_W_FULL, 0, ADJUST_H) })
	Tween(self.CloseBtn,  SLIDE, { Position = UDim2.new(0, LIGHT_FULL.Close,  0.5, -6) })
	Tween(self.ExpandBtn, SLIDE, { Position = UDim2.new(0, LIGHT_FULL.Expand, 0.5, -6) })

	task.delay(RESTORE_LEAD, function()
		if self.Minimized then return end
		self.MinimizeBtn.Visible = true
		Tween(self.MinimizeBtn, RESTORE_FADE, { BackgroundTransparency = 0 })

		task.delay(0.04, function()
			if not self.Body.Parent or self.Minimized then return end
			self.Body.Size = UDim2.new(1, 0, 0, 0)
			self.Body.Visible = true
			Tween(self.Body, RESTORE_EXPAND, { Size = UDim2.new(1, 0, 1, 0) })

			task.delay(0.20, function()
				if self.Body.Parent then self.Body.ClipsDescendants = false end
				if self.SnapToPixels then self.SnapToPixels() end
				self.Animating = false
			end)
		end)
	end)
end

-- Push every element's current value through its callback. Call once after
-- building the UI so the game starts in the state the controls are showing.
-- Plain table, safe for JSONEncode. Colours and KeyCodes are wrapped.
function Window:GetConfig()
	local out = {}
	for flag, getter in pairs(self.Flags) do
		out[flag] = EncodeValue(getter())
	end
	return out
end

-- Restores silently, then fires every callback once at the end. Applying
-- per key would run callbacks in table order, mid-restore.
function Window:LoadConfig(cfg, apply)
	for flag, raw in pairs(cfg or {}) do
		local setter = self.Setters[flag]
		if setter then
			local ok, err = pcall(setter, DecodeValue(raw))
			if not ok then warn("[Saturn] LoadConfig failed for '" .. flag .. "': " .. tostring(err)) end
		end
	end
	if apply ~= false then
		self:ApplyDefaults()
	end
end

function Window:Success(title, text, duration)
	return self:Notify({ Title = title, Text = text, Duration = duration, Type = "success" })
end

function Window:Warn(title, text, duration)
	return self:Notify({ Title = title, Text = text, Duration = duration, Type = "warning" })
end

function Window:Error(title, text, duration)
	return self:Notify({ Title = title, Text = text, Duration = duration, Type = "error" })
end

function Window:ApplyDefaults()
	for _, fn in ipairs(self.InitCallbacks) do
		fn()
	end
end

local NOTIF_W   = 280
local NOTIF_MAX = 5
local notifOrder = 0

-- Reuses the traffic-light colours, so variants already belong to the palette.
local NOTIF_TYPES = {
	success = Theme.Expand,
	warning = Theme.Minimize,
	error   = Theme.Close,
}

function Window:Notify(opts)
	opts = opts or {}
	local duration = opts.Duration or 4
	local accent   = opts.Accent or NOTIF_TYPES[opts.Type] or Theme.Accent
	local text     = opts.Text or opts.Description

	-- Retire the oldest once the stack is full.
	while #self.NotifStack >= NOTIF_MAX do
		local oldest = table.remove(self.NotifStack, 1)
		if oldest then oldest() end
	end

	notifOrder += 1

	local holder = Create("Frame", {
		Name = "Notification",
		Size = UDim2.new(0, NOTIF_W, 0, 70),
		BackgroundTransparency = 1,
		LayoutOrder = notifOrder,
		Parent = self.NotifHolder,
	})

	local card = Create("Frame", {
		Name = "Card",
		Size = UDim2.new(1, 0, 1, 0),
		Position = UDim2.new(0, 40, 0, 0),   -- slides in from the right
		BackgroundColor3 = Theme.Background,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Parent = holder,
	})
	Corner(10, card)
	local cardStroke = Stroke(card, Theme.StrokeOuter, 1.3)
	cardStroke.Transparency = 1

	-- Fading the pieces by hand rather than with a CanvasGroup: the group
	-- would resample the text and leave it soft.
	local fadeParts = { { card, "BackgroundTransparency", 0 },
						{ cardStroke, "Transparency", 0 } }

	local function fadeTo(hidden, info)
		for _, p in ipairs(fadeParts) do
			Tween(p[1], info, { [p[2]] = hidden and 1 or p[3] })
		end
	end

	local cardShadow = Shadow(card, nil, 0.41, 20)
	local shadowBase = 0.41
	if cardShadow and cardShadow:IsA("ImageLabel") then
		cardShadow.ImageTransparency = 1     -- fades in with the card
	else
		cardShadow = nil
	end

	-- Floating bar in its own gutter, same as every element card.
	-- Not named "Design": SetAccent recolours those, which would stomp
	-- the per-type colours.
	local bar = Create("Frame", {
		Name = "NotifBar",
		Size = UDim2.new(0, 4, 0, 38),
		Position = UDim2.new(0, 7, 0, 12),
		BackgroundColor3 = accent,
		BorderSizePixel = 0,
		Parent = card,
	})
	Corner(8, bar)
	bar.BackgroundTransparency = 1
	table.insert(fadeParts, { bar, "BackgroundTransparency", 0 })

	local notifTitle = Create("TextLabel", {
		Name = "Title",
		Size = UDim2.new(1, -43, 0, 16),
		Position = UDim2.new(0, 29, 0, 12),
		BackgroundTransparency = 1,
		Text = opts.Title or "Notification",
		TextColor3 = Theme.TextPrimary,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextTransparency = 1,
		FontFace = FONT_MED,
		Parent = card,
	})
	table.insert(fadeParts, { notifTitle, "TextTransparency", 0 })

	local body = Create("TextLabel", {
		Name = "Body",
		Size = UDim2.new(1, -43, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Position = UDim2.new(0, 29, 0, 32),
		BackgroundTransparency = 1,
		Text = text or "",
		TextColor3 = Theme.TextMuted,
		TextSize = 12,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		FontFace = FONT_MED,
		TextTransparency = 1,
		Visible = (text ~= nil and text ~= ""),
		Parent = card,
	})
	table.insert(fadeParts, { body, "TextTransparency", 0 })

	-- Timer: anchored at its centre, so shrinking pulls both ends inward.
	local timer = Create("Frame", {
		Name = "Timer",
		Size = UDim2.new(1, -58, 0, 2),
		Position = UDim2.new(0.5, 0, 1, -13),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = accent,
		BorderSizePixel = 0,
		Parent = card,
	})
	Corner(1, timer)
	timer.BackgroundTransparency = 1
	table.insert(fadeParts, { timer, "BackgroundTransparency", 0 })
	Create("UIGradient", {
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0,   1),
			NumberSequenceKeypoint.new(0.5, 0),
			NumberSequenceKeypoint.new(1,   1),
		}),
		Parent = timer,
	})

	-- title 12-28 / body 32-(32+bodyH) / timer at h-13, 12px pad top and
	-- bottom. The bar bounds the text block and clears the body by 4px,
	-- leaving 8px before the timer.
	local function fit()
		local bodyH = body.Visible and math.max(body.AbsoluteSize.Y, 14) or 0
		holder.Size = UDim2.new(0, NOTIF_W, 0, bodyH + 58)
		bar.Size    = UDim2.new(0, 4, 0, bodyH + 24)
	end
	body:GetPropertyChangedSignal("AbsoluteSize"):Connect(fit)
	fit()

	-- ---- lifecycle ----
	local dismissed = false
	local dismiss

	dismiss = function()
		if dismissed then return end
		dismissed = true

		for i, fn in ipairs(self.NotifStack) do
			if fn == dismiss then
				table.remove(self.NotifStack, i)
				break
			end
		end

		Tween(card, NOTIF_OUT, { Position = UDim2.new(0, 40, 0, 0) })
		fadeTo(true, NOTIF_OUT)
		if cardShadow then
			Tween(cardShadow, NOTIF_OUT, { ImageTransparency = 1 })
		end
		task.delay(0.22, function()
			if holder.Parent then holder:Destroy() end
		end)
	end

	table.insert(self.NotifStack, dismiss)

	Tween(card, NOTIF_IN, { Position = UDim2.new(0, 0, 0, 0) })
	fadeTo(false, NOTIF_IN)
	if cardShadow then
		Tween(cardShadow, NOTIF_IN, { ImageTransparency = shadowBase })
	end
	Tween(timer, TweenInfo.new(duration, Enum.EasingStyle.Linear),
		{ Size = UDim2.new(0, 0, 0, 2) })

	ClickLayer(card, 10).MouseButton1Click:Connect(dismiss)
	task.delay(duration, dismiss)

	return { Instance = card, Dismiss = dismiss }
end

function Window:Destroy()
	for _, c in ipairs(self.Connections) do
		pcall(function() c:Disconnect() end)
	end
	table.clear(self.Connections)
	for _, group in ipairs(self.ConnGroups) do
		DisconnectAll(group)
	end
	table.clear(self.ConnGroups)
	table.clear(self.InitCallbacks)
	table.clear(self.Setters)

	-- Only drop mirrors this window still owns; a newer window may have
	-- replaced the entry under the same flag name.
	for k, getter in pairs(self.Flags) do
		if Saturn.Flags[k] == getter then
			Saturn.Flags[k] = nil
		end
	end
	table.clear(self.Flags)

	self.Gui:Destroy()
end

