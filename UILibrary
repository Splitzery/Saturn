local Window = {}
Window.__index = Window

function Window:_selectTab(tab)
	if self.ActiveTab == tab then return end

	local box, bar = self.SelectionBox, self.SelectionBar
	local prev = self.ActiveTab
	local wasPinned = prev and prev.Pinned
	local first = (prev == nil)

	for _, t in ipairs(self.Tabs) do
		local active = (t == tab)
		t.Page.Visible = active
		Tween(t.Button.TabName, FAST, { TextColor3 = active and Theme.TextPrimary or Theme.TextMuted })
		Tween(t.Button.TabIcon, FAST, { ImageColor3 = active and Theme.TextPrimary or Theme.TextMuted })

		-- Turns on the way in and on the way out, always the same direction.
		if t.Spin and (active or t == prev) then
			t.SpinAngle += 180
			Tween(t.Button.TabIcon, GEAR_SPIN, { Rotation = t.SpinAngle })
		end

		if t.Pinned then
			Tween(t.Button, FAST, { BackgroundTransparency = active and 0 or 1 })
			local pinBar = t.Button:FindFirstChild("SelectedIcon")
			if pinBar then
				Tween(pinBar, active and SEL_GROW or SEL_SHRINK,
					{ Size = UDim2.new(0, 4, 0, active and SEL_BAR_H or 0) })
			end
		end
	end

	if tab.Pinned then
		-- Leaving the list: box and its bar retract together.
		Tween(box, FADE, { BackgroundTransparency = 1 })
		Tween(bar, SEL_SHRINK, { Size = UDim2.new(0, 4, 0, 0) })
	else
		local y = (tab.SidebarIndex - 1) * TAB_STEP - self.SideBarContainer.CanvasPosition.Y
		local target = UDim2.new(0, 0, 0, y)

		if first or wasPinned then
			box.Position = target
			Tween(box, FADE, { BackgroundTransparency = 0 })
			Tween(bar, SEL_GROW, { Size = UDim2.new(0, 4, 0, SEL_BAR_H) })
		else
			-- Sidebar to sidebar: the bar is a child of the box, so it travels for free.
			Tween(box, SEL_SLIDE, { Position = target })
		end
	end

	self.ActiveTab = tab

	if self.SearchBox then
		self:_applySearch(self.SearchOpen and self.SearchBox.Text or "")
	end
end

